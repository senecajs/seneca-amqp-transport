{
  "name": "@seneca/amqp-transport",
  "version": "2.2.0",
  "codename": "Migrative Meathook",
  "description": "Official AMQP transport plugin for Seneca",
  "main": "index.js",
  "files": [
    "index.js",
    "lib/*",
    "defaults.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "coverage": "NODE_ENV=test node --test --experimental-test-coverage 'test/**/*.test.js'",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "NODE_ENV=test node --test 'test/**/*.test.js'",
    "test:e2e": "NODE_ENV=test node --test --test-concurrency=1 'e2e/**/*.e2e.js'",
    "lint": "eslint index.js lib test",
    "validate": "npm-run-all lint test:unit",
    "integrate": "npm-run-all lint coverage",
    "release": "./scripts/release.sh",
    "prettier": "prettier --write index.js lib/**/*.js examples/**/*.js e2e/**/*.js test/**/*.js",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down -v"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:senecajs/seneca-amqp-transport.git"
  },
  "keywords": [
    "seneca",
    "official",
    "plugin",
    "amqp",
    "transport",
    "rabbitmq",
    "zmq",
    "activemq",
    "microservice",
    "rpc"
  ],
  "author": "Nicolás Fantone <nfantone@gmail.com> (https://github.com/nfantone)",
  "contributors": [
    "George Haidar <ghaidar0@gmail.com> (https://github.com/disintegrator)",
    "Chris Spiliotopoulos <chrysanthos.spiliotopoulos@gmail.com> (https://github.com/chefArchitect)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/senecajs/seneca-amqp-transport/issues"
  },
  "homepage": "https://github.com/senecajs/seneca-amqp-transport",
  "dependencies": {
    "amqplib": "^2.2.0",
    "amqpuri": "^2.0.1",
    "bluebird": "^3.5.1",
    "jsonic": "^0.3.0",
    "lodash": "^4.17.10",
    "seneca-transport": "^8.3.0",
    "uuid": "^3.2.1"
  },
  "devDependencies": {
    "chai": "^4.1.2",
    "chai-json-schema": "^1.5.0",
    "dirty-chai": "^2.0.1",
    "eslint": "^5.0.0",
    "eslint-config-prettier": "^3.0.0",
    "eslint-plugin-prettier": "^2.6.0",
    "eslint-plugin-standard": "^3.1.0",
    "npm-run-all": "^4.1.2",
    "prettier": "^1.12.1",
    "seneca": "^4.0.0-rc5",
    "sinon": "^6.0.0",
    "sinon-chai": "^3.0.0"
  },
  "peerDependencies": {
    "seneca": ">=3 || >=4.0.0-rc5"
  }
}
